{% extends "layout/layout.twig" %}

{% block content %}
<section class="content">
	<div class="container">
    {# {{ post.content }} #}

	<hr />

	{% set tabs_data = [
		{'anchor': 'Tab 1', 'content': {'text': 'This is content of Tab 1'}},
		{'anchor': 'Tab 2', 'content': {'text': 'This is content of Tab 2'}},
		{'anchor': 'Tab 3', 'content': {'text': 'This is content of Tab 3'}}
	] %}

	{% include 'components/tabs.twig' with {
		'class': 'my-custom-tabs',
		'tabs': tabs_data
	} %}

	{% include 'components/tabs.twig' with {
		'class': 'my-tabs',
		'tabs': tabs_data,
		'tab_anchor_0': '<strong>Custom Anchor for Tab 1</strong>',
		'tab_panel_1': '<h3>Custom Panel for Tab 2</h3><p>More detailed content here...</p>'
	} %}

	<hr />

{% embed 'components/collapsible.twig' with {
    'class': 'my-collapsible-class',
    'aria_label': 'Toggle Additional Info',
    'duration': 700,
    'close_outside': true,
    'on_hover': false,
    'custom_keyframes': [
        {'opacity':0,'transform':'translateY(-10px)','pointer-events':'none'},
        {'transform':'translateY(10px)','offset':0.9},
        {'opacity':1,'transform':'translateY(0)','pointer-events':'all'}
    ],
    'easing': 'cubic-bezier(1,-0.06, 0, 1.56)'
} %}
    {% block collapsible_trigger %}
        <strong>Click to Toggle</strong>
    {% endblock %}

    {% block collapsible_content %}
        <h4>Additional Information</h4>
        <p>This content is revealed when the collapsible is opened.</p>
    {% endblock %}
{% endembed %}

<ht />


{% set dd_options = [
    {'value': 'none', 'label': 'Select Option'},
    {'value': 'option-1', 'label': 'Option 1'},
    {'value': 'option-2', 'label': 'Option 2'},
] %}

{% include 'components/dropdown-select.twig' with {
    class: 'my-dropdown',
    aria_label: 'Select an option',
    duration: '500',
    close_outside: true,
    is_absolute: true,
    on_hover: false,
    easing: 'cubic-bezier(1,-0.06, 0, 1.56)',
    options: dd_options,
    default_selected_key: 1
} %}


<h1>Accordion</h1>

{% set items = [
    {'anchor': 'Item 1', 'content': {'text': 'Content for Item 1'}},
    {'anchor': 'Item 2', 'content': {'text': 'Content for Item 2'}},
    {'anchor': 'Item 3', 'content': {'text': 'Content for Item 3'}}
] %}

{% include 'components/accordion.twig' with {
    'class': 'custom-accordion-class',
    'items': items,
    'collapse_siblings': true,
    'initially_open_item': 1,
    'duration': 500,
    'easing': 'ease-in-out',
    'aria_label': 'Toggle section'
} %}


<hr />

<h2>Customized with blocks</h2>

{% embed 'components/accordion.twig' with {
    'class': 'custom-accordion',
    'items': items,
    'collapse_siblings': true,
    'initially_open_item': 0
} %}
    {% block acc_trigger %}
        <strong>{{ item.anchor|default('Custom Trigger') }}</strong>
    {% endblock %}

    {% block acc_content %}
        <p>{{ item.content.text|default('Custom Content') }}</p>
    {% endblock %}
{% endembed %}


<h1>Video</h1>
{% include 'components/video.twig' with {
	'video_type': 'youtube',
	'video_id': 'co1r5krHsl4'
} %}

<h2>Latest blog posts</h2>
{% include 'components/latest-blog-posts.twig' with {
    args: {
        'post_type': 'post',
        'posts_per_page': 5,
        'orderby': 'date',
        'order': 'DESC'
